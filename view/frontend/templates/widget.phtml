<?php
/** @var \Idea89\Assistant\Block\Widget $block */
if (!$block->shouldRender()) {
    return;
}
?>
<?php /** @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer */ ?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $block->getClientBootstrapJs(), false) ?>
<?php $widgetScript = $block->getWidgetScript(); ?>
<script
    src="<?= $block->escapeUrl($widgetScript['src']) ?>"
    <?php if ($widgetScript['integrity'] !== null): ?>
    integrity="<?= $block->escapeHtmlAttr($widgetScript['integrity']) ?>"
    crossorigin="anonymous"
    <?php endif; ?>
    data-key="<?= $block->escapeHtmlAttr($block->getApiKey()) ?>"
    data-position="<?= $block->escapeHtmlAttr($block->getWidgetPosition()) ?>"
    async
></script>
