 * @var \Idea89\Assistant\Block\Checkout\Bridge $block
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */
if (!$block->shouldRender()) {
    return;
}

// Branch on the declared mode, not on payload nullity — bridge_mode is what
// tells the success page from the mini-checkout page (see Bridge::getBridgeMode()
// docblock for why session state alone can't be trusted for that). In success
// mode with no payload (belt-and-braces case: the layout says success but no
// real order is present), emit nothing at all rather than guessing.
if ($block->getBridgeMode() === 'success') {
    $successPayload = $block->getSuccessPayloadJson();
    if ($successPayload === null) {
        return;
    }
    $successJs = 'post(' . $successPayload . ');';
} else {
    $successJs = "post({source:'idea89-checkout',type:'ready'});"
        . "var last=0;var send=function(){"
        . "var h=Math.ceil(document.documentElement.scrollHeight);"
        . "if(Math.abs(h-last)<12){return;}last=h;"
        . "post({source:'idea89-checkout',type:'resize',height:h});};"
        . "send();"
        . "if(window.ResizeObserver){new ResizeObserver(send).observe(document.body);}"
        . "else{setInterval(send,600);}";
}

$js = "(function(){"
    . "if(window.parent===window){return;}"
    . "var post=function(m){try{window.parent.postMessage(m,window.location.origin);}catch(e){}};"
    . $successJs
    . "})();";

// The framed checkout sits under the widget's own "Checkout" header, so the
// page's title is a duplicate. In a ~600px frame a theme's large title also
// ran into the "Sign In" link Magento floats beside it (live d89, a 64px
// title, 2026-10-07): hide the title and give Sign In its own line.
$css = 'body.idea89-mini-checkout .page-title-wrapper{display:none}'
    . 'body.idea89-mini-checkout .authentication-wrapper'
    . '{float:none;margin:0 0 12px;max-width:none;text-align:right}';
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $js, false) ?>
<?php if ($block->getBridgeMode() !== 'success'): ?>
<?= /* @noEscape */ $secureRenderer->renderTag('style', [], $css, false) ?>
<?php endif; ?>
